<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="res_config_settings_view_form" model="ir.ui.view">
		<field name="name">res.config.settings.view.form.dooprint.pos</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<!-- The Dooprint printer is set on the point of sale form; here it only keeps the
			     automatic printing options visible. -->
			<xpath expr="//setting[@id='auto_printing']/div" position="attributes">
				<attribute name="invisible">not pos_iface_print_auto or not pos_is_posbox and not pos_other_devices and not pos_dooprint_printer_id</attribute>
			</xpath>
			<setting id="auto_printing" position="inside">
				<field name="pos_dooprint_printer_id" invisible="1"/>
			</setting>
		</field>
	</record>
</odoo>
