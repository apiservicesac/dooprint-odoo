<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="pos_printer_view_form" model="ir.ui.view">
		<field name="name">pos.printer.view.form.dooprint</field>
		<field name="model">pos.printer</field>
		<field name="inherit_id" ref="point_of_sale.view_pos_printer_form"/>
		<field name="arch" type="xml">
			<!-- The core hides the printer type so a module that adds one can show it. -->
			<field name="printer_type" position="attributes">
				<attribute name="invisible">False</attribute>
			</field>
			<field name="printer_ip" position="after">
				<field name="dooprint_printer_id" invisible="printer_type != 'dooprint'"
					required="printer_type == 'dooprint'" options="{'no_create': True}"/>
				<field name="dooprint_delivery" widget="radio" invisible="printer_type != 'dooprint'"/>
				<field name="dooprint_url" invisible="1"/>
			</field>
			<widget name="point_of_sale_test_epos" position="after">
				<widget name="dooprint_pos_test" invisible="printer_type != 'dooprint'"/>
			</widget>
		</field>
	</record>
</odoo>
