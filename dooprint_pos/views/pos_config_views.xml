<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="pos_config_view_form" model="ir.ui.view">
		<field name="name">pos.config.view.form.dooprint</field>
		<field name="model">pos.config</field>
		<field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
		<field name="arch" type="xml">
			<setting id="other_devices" position="after">
				<setting id="dooprint" string="Dooprint Printer"
					help="Print receipts and open the cash drawer with a printer of a Dooprint device">
					<div class="content-group">
						<div class="row mb-2">
							<div class="col-lg-6 o_light_label">
								<label string="Printer" for="dooprint_printer_id"/>
							</div>
							<div class="col-lg-6">
								<field name="dooprint_printer_id" options="{'no_create': True}"/>
							</div>
						</div>
						<div class="row mb-2">
							<div class="col-lg-6 o_light_label">
								<label string="Delivery" for="dooprint_delivery"/>
							</div>
							<div class="col-lg-6">
								<field name="dooprint_delivery" widget="radio"/>
							</div>
						</div>
						<div class="row" invisible="not dooprint_printer_id">
							<div class="col-lg-6 o_light_label">
								<label string="Link Cashdrawer" for="iface_cashdrawer"/>
							</div>
							<div class="col-lg-6">
								<field name="iface_cashdrawer"/>
							</div>
						</div>
						<div class="text-muted small mt-2">The delivery also applies to the preparation printers of type Dooprint.</div>
						<div invisible="not dooprint_printer_id">
							<widget name="dooprint_pos_test"/>
						</div>
					</div>
				</setting>
			</setting>
		</field>
	</record>
</odoo>
