<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record model="ir.module.category" id="module_category_dooprint">
			<field name="name">Dooprint</field>
			<field name="sequence">45</field>
		</record>

		<record model="res.groups.privilege" id="res_groups_privilege_dooprint">
			<field name="name">Dooprint</field>
			<field name="category_id" ref="module_category_dooprint"/>
			<field name="sequence">10</field>
		</record>

		<record id="group_dooprint_user" model="res.groups">
			<field name="name">User</field>
			<field name="sequence">10</field>
			<field name="comment">Sees the devices, their printers and the job queue.</field>
			<field name="privilege_id" ref="res_groups_privilege_dooprint"/>
			<field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
		</record>

		<record id="group_dooprint_manager" model="res.groups">
			<field name="name">Administrator</field>
			<field name="sequence">20</field>
			<field name="comment">Connects devices, sends test pages and remote commands.</field>
			<field name="privilege_id" ref="res_groups_privilege_dooprint"/>
			<field name="implied_ids" eval="[(4, ref('group_dooprint_user'))]"/>
			<field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
		</record>
	</data>

	<data noupdate="1">
		<record id="dooprint_device_company_rule" model="ir.access">
			<field name="name">Print devices: multi-company</field>
			<field name="model_id" ref="model_dooprint_device"/>
			<field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
			<field name="operation">crud</field>
		</record>
		<record id="dooprint_printer_company_rule" model="ir.access">
			<field name="name">Printers: multi-company</field>
			<field name="model_id" ref="model_dooprint_printer"/>
			<field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
			<field name="operation">crud</field>
		</record>
		<record id="dooprint_job_company_rule" model="ir.access">
			<field name="name">Print jobs: multi-company</field>
			<field name="model_id" ref="model_dooprint_job"/>
			<field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
			<field name="operation">crud</field>
		</record>
	</data>
</odoo>
